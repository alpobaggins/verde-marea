generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
  super_admin
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
  no_show
}

enum ClosureKind {
  day
  window
}

enum AuditAction {
  booking_created
  booking_status_changed
  user_role_changed
  availability_closed
  availability_reopened
  table_availability_changed
}

enum AuditTarget {
  booking
  user
  availability_closure
  table
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(user)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  bookings     Booking[]
  auditEntries AuditLog[]
}

model Table {
  id          String    @id @default(uuid()) @db.Uuid
  label       String    @unique
  capacity    Int
  isAvailable Boolean   @default(true)
  bookings    Booking[]

  @@index([isAvailable, capacity, id])
}

model Booking {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  tableId       String         @db.Uuid
  startsAt      DateTime       @db.Timestamptz(3)
  endsAt        DateTime       @db.Timestamptz(3)
  guestCount    Int
  status        BookingStatus  @default(pending)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  table         Table          @relation(fields: [tableId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  notifications Notification[]

  @@unique([id, userId])
  @@index([userId, startsAt])
  @@index([tableId, startsAt])
  @@index([startsAt])
}

model Notification {
  id          String        @id @default(uuid()) @db.Uuid
  bookingId   String        @db.Uuid
  recipientId String        @db.Uuid
  status      BookingStatus
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  readAt      DateTime?     @db.Timestamptz(3)
  booking     Booking       @relation(fields: [bookingId, recipientId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([bookingId, status])
  @@index([recipientId, createdAt])
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String      @db.Uuid
  actorRole  Role
  action     AuditAction
  targetType AuditTarget
  targetId   String      @db.Uuid
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

/// Закрытие даты или окна для всего ресторана. Доступность отдельных столов задаётся в Table.
model AvailabilityClosure {
  id        String      @id @default(uuid()) @db.Uuid
  kind      ClosureKind
  startsAt  DateTime    @db.Timestamptz(3)
  endsAt    DateTime    @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([startsAt, endsAt])
}
