# Локальная база только для Verde Marea. Замените имя роли, пароль и порт.
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/verde_marea_dev"

# Заполните собственными паролями для трёх демонстрационных аккаунтов.
SEED_SUPER_ADMIN_PASSWORD=
