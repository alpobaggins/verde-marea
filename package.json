{
  "name": "verde-marea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test:strict": "node scripts/test-strict.mjs",
    "test:auth": "prisma generate && tsx --test tests/auth.test.ts",
    "test:availability": "prisma generate && tsx --test tests/availability.test.ts",
    "test:booking": "prisma generate && tsx --test tests/booking.test.ts",
    "test:account": "prisma generate && tsx --test tests/account.test.ts",
    "test:admin-booking": "prisma generate && tsx --test tests/admin-booking.test.ts",
    "test:admin-availability": "prisma generate && tsx --test tests/admin-availability.test.ts",
    "test:admin-identity": "prisma generate && tsx --test tests/admin-identity.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.10",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    }
  }
}
